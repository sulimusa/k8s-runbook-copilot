# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Ollama, vLLM, LiteLLM, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# Local example (Ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Optional: enables hybrid (BM25 + embeddings) retrieval. Leave empty for keyword-only.
EMBED_MODEL=
# EMBED_MODEL=text-embedding-3-small

# Retrieval gate / abstention tuning
TOP_K=6
MIN_BM25_SCORE=4.0
MIN_QUERY_COVERAGE=0.4
# A match this strong (BM25) overrides the keyword scope check. Calibrated on the dev eval set: re-tune as the corpus grows.
STRONG_MATCH_SCORE=20.0
MIN_CONFIDENCE=0.35

# Deployment identity: attached to every trace and metric (set by Helm / CI in real deployments)
APP_ENV=local
APP_VERSION=dev

# OpenTelemetry (off by default). See docs/observability.md
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional cost tracking: USD per 1M tokens, copied from your provider's pricing page
# LLM_PRICE_IN_PER_1M=
# LLM_PRICE_OUT_PER_1M=

# Logging: store question text in logs? (default: hash only)
LOG_QUESTIONS=false
